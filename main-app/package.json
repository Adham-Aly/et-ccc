{
  "name": "et-ccc-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/assert-contained.mjs && next dev",
    "build": "node scripts/assert-contained.mjs && node scripts/build-lock.mjs -- next build",
    "start": "node scripts/assert-contained.mjs && next start",
    "lint": "node scripts/assert-contained.mjs && biome check .",
    "typecheck": "node scripts/assert-contained.mjs && tsc --noEmit",
    "test:unit": "node scripts/assert-contained.mjs && vitest run",
    "lint:light": "node scripts/assert-contained.mjs && node scripts/gates/lint-light.mjs",
    "content:check": "node scripts/assert-contained.mjs && node --import ./tools/viz/register.mjs scripts/gates/content-check.ts",
    "content:status": "node scripts/assert-contained.mjs && node --import ./tools/viz/register.mjs scripts/gates/content-status.ts",
    "lint:r14": "node scripts/assert-contained.mjs && node scripts/gates/lint-r14.mjs",
    "spell": "node scripts/assert-contained.mjs && cspell --no-progress \"content/**\" \"tests/fixtures/content/**\" \"*.md\"",
    "lint:mdx": "node scripts/assert-contained.mjs && remark . --ext mdx --frail",
    "check:python": "node scripts/assert-contained.mjs && node --import ./tools/viz/register.mjs tools/pycheck/check-python.ts",
    "gen:outputs": "node scripts/assert-contained.mjs && node --import ./tools/viz/register.mjs tools/pycheck/gen-outputs.ts",
    "style:check": "node scripts/assert-contained.mjs && node tools/style/check-style.mjs",
    "gen:viz": "node scripts/assert-contained.mjs && node --import ./tools/viz/register.mjs tools/viz/gen-viz.ts",
    "check:viz": "node scripts/assert-contained.mjs && node --import ./tools/viz/register.mjs tools/viz/check-viz.ts",
    "viz:shots": "node scripts/assert-contained.mjs && node --import ./tools/viz/register.mjs tools/viz/viz-shots.ts",
    "prebuild": "node scripts/assert-contained.mjs && node scripts/gates/prebuild.mjs",
    "test:e2e": "node scripts/assert-contained.mjs && node scripts/check-production-mode.mjs && node scripts/run-playwright.mjs e2e playwright.config.ts 4100",
    "test:visual": "node scripts/assert-contained.mjs && node scripts/run-playwright.mjs visual playwright.visual.config.ts 4101",
    "test:a11y": "node scripts/assert-contained.mjs && node scripts/run-playwright.mjs a11y playwright.a11y.config.ts 4102",
    "links:verify": "node scripts/assert-contained.mjs && node tools/links/verify-judges.mjs",
    "links:internal": "node scripts/assert-contained.mjs && node scripts/links-internal.mjs",
    "perf": "node scripts/assert-contained.mjs && node scripts/perf-budgets.mjs",
    "deployed-url": "node scripts/assert-contained.mjs && node scripts/deployed-url.mjs",
    "verify:fast": "node scripts/assert-contained.mjs && node scripts/verify.mjs fast",
    "verify:full": "node scripts/assert-contained.mjs && node scripts/verify.mjs full",
    "verify:preview": "node scripts/assert-contained.mjs && node scripts/verify.mjs preview"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "clsx": "2.1.1",
    "d3-hierarchy": "3.1.2",
    "katex": "0.18.9",
    "lucide-react": "1.47.0",
    "minisearch": "7.2.0",
    "motion": "12.43.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.3.3",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "postcss": "8.5.28",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "remark-preset-lint-consistent": "6.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
