{
  "name": "et-ccc-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/assert-contained.mjs && next dev",
    "build": "node scripts/assert-contained.mjs && node scripts/build-lock.mjs -- next build",
    "start": "node scripts/assert-contained.mjs && next start",
    "lint": "node scripts/assert-contained.mjs && biome check .",
    "typecheck": "node scripts/assert-contained.mjs && tsc --noEmit",
    "test:unit": "node scripts/assert-contained.mjs && vitest run",
    "lint:light": "node scripts/assert-contained.mjs && node scripts/gates/lint-light.mjs",
    "test:e2e": "node scripts/assert-contained.mjs && playwright test",
    "verify:fast": "node scripts/assert-contained.mjs && node scripts/verify.mjs fast",
    "verify:full": "node scripts/assert-contained.mjs && node scripts/verify.mjs full"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@mdx-js/mdx": "3.1.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "katex": "0.18.9",
    "rehype-slug": "6.0.0",
    "shiki": "4.4.3",
    "zod": "4.6.5",
    "yaml": "2.9.1",
    "motion": "12.43.0",
    "d3-hierarchy": "3.1.2",
    "minisearch": "7.2.0",
    "@base-ui/react": "1.8.0",
    "lucide-react": "1.47.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "postcss": "8.5.28",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/d3-hierarchy": "3.1.7",
    "@biomejs/biome": "2.5.14",
    "vitest": "5.0.1",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "linkinator": "8.1.0",
    "cspell": "10.3.3",
    "remark-cli": "12.0.1",
    "remark-mdx": "3.1.1",
    "remark-preset-lint-recommended": "7.0.1",
    "remark-preset-lint-consistent": "6.0.1",
    "lighthouse": "13.5.0"
  }
}
