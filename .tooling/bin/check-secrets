#!/bin/bash
# check-secrets — G-SECRETS (plan §7): no tokens or .env files in what git would commit.
# Scans every file that is staged or tracked (git ls-files --cached) plus untracked-but-not-ignored files.
# Exit 0 clean, 1 on any finding.
set -u
ROOT="/Users/adham/Developer/et-ccc"
GIT="$ROOT/.tooling/bin/git"
cd "$ROOT" || exit 2
FOUND=0
FILES="$("$GIT" ls-files --cached --others --exclude-standard)"
# 1. forbidden file names
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$(basename "$f")" in
    .env|.env.*|*.pem|*.p12|*.key|id_rsa*|id_ed25519*|.npmrc.local|hosts.yml)
      echo "G-SECRETS: forbidden file would be committed: $f"; FOUND=1;;
  esac
done <<< "$FILES"
# 2. token patterns (real token shapes, not mentions of the prefixes)
PAT='(gh[pousr]_[A-Za-z0-9]{36,})|(github_pat_[A-Za-z0-9_]{22,})|(-----BEGIN [A-Z ]*PRIVATE KEY-----)|(xox[abpr]-[A-Za-z0-9-]{10,})|(AKIA[0-9A-Z]{16})|(sk-[A-Za-z0-9]{32,})'
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if /usr/bin/grep -EIn "$PAT" "$f" >/dev/null 2>&1; then
    /usr/bin/grep -EIn "$PAT" "$f" | sed -E 's/(gh[pousr]_|github_pat_|sk-)[A-Za-z0-9_]{4,}/\1***REDACTED***/g' | sed "s|^|G-SECRETS: $f:|"
    FOUND=1
  fi
done <<< "$FILES"
# 3. large files (> 5 MB) — no binaries in the repo
while IFS= read -r f; do
  [ -f "$f" ] || continue
  sz=$(/usr/bin/stat -f %z "$f"); [ "$sz" -gt 5242880 ] && { echo "G-SECRETS: large file ($sz bytes): $f"; FOUND=1; }
done <<< "$FILES"
n=$(printf '%s\n' "$FILES" | grep -c .)
if [ "$FOUND" = 0 ]; then echo "G-SECRETS: PASS ($n files checked)"; exit 0; else echo "G-SECRETS: FAIL"; exit 1; fi
