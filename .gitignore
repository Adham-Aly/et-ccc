# et-ccc .gitignore (plan §10.3)

# Tool state lives in .tooling/ (plan §9.1); only config and docs are tracked
.tooling/*
!.tooling/env.sh
!.tooling/npmrc
!.tooling/bin/
!.tooling/README.md
!.tooling/contain-allowlist.txt
!.tooling/requirements-tools.txt
!.tooling/guard-cases.tsv

# Build and test output
node_modules/
.next/
out/
test-results/
playwright-report/
*.tsbuildinfo

# tools/pycheck scratch (fenced-code-block temp files, deleted at the end of every run;
# gitignored as a safety net if a run is interrupted)
main-app/.pycheck-scratch/

# Phase scratch and run files
work/**/_scratch/
work/**/_run/

# Secrets and machine-local config
.env*
.vercel/
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# OS
.DS_Store
